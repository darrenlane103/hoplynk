# Required: Path to the dataset JSON file
DATA_FILE=data/work_sample_data.json

# Optional: Server port (defaults to 3001 in development, 3000 otherwise)
PORT=3001

# Optional in development, Required in production/staging: Comma-separated list of allowed CORS origins
# Development: defaults to http://localhost:3000 if not set
# Production/Staging: MUST be set or application will not start
ALLOWED_ORIGINS=http://localhost:3000

# Optional: Node environment (development, production, staging, etc.)
# Defaults to 'development' if not set
NODE_ENV=development
